"""
Tests for inter-rater annotation numbering

Tests the implementation of numbered inter-rater annotations ([inter-rating-1], [inter-rating-2], etc.)
as specified in OpenSpec change: update-inter-rater-annotation-numbering

Related files:
- backend/telemetry/feedback.py:318-325 (get_annotation_name function)
- backend/telemetry/feedback.py:292-322 (inter-rater number determination)
"""

import pytest
import asyncio
from unittest.mock import Mock, patch, AsyncMock, MagicMock
from backend.telemetry.feedback import submit_span_annotation


class TestInterRaterAnnotationNumbering:
    """Test suite for inter-rater annotation numbering functionality"""

    def test_get_annotation_name_original_feedback(self):
        """Test that original (non-inter-rater) feedback has no prefix"""
        # This test validates that the get_annotation_name function
        # returns the base name without any prefix for original feedback

        # Mock the necessary components
        with patch('backend.telemetry.feedback.find_qa_span_id', return_value=12345):
            feedback_data = {
                'relevance': 5,
                'is_inter_rater': False,
            }

            # The function should be tested directly, but since it's nested,
            # we'll test via the full submission flow
            result = submit_span_annotation(
                span_id='12345',
                feedback_data=feedback_data,
                qa_id='test_qa_1'
            )

            # For now, we're setting up the structure
            # Full assertions will depend on Phoenix API mocking
            assert result is not None

    @pytest.mark.asyncio
    async def test_first_inter_rater_gets_number_one(self):
        """
        Test: First inter-rater submission shows [inter-rating-1]

        Scenario from spec:
        - WHEN the first inter-rater submits feedback for a span
        - THEN the annotation name SHALL be prefixed with [inter-rating-1]
        """
        # Mock Phoenix client to return count = 0 (no existing inter-raters)
        with patch('backend.services.phoenix_client.phoenix_client') as mock_client:
            mock_client.get_inter_rater_count = AsyncMock(return_value=0)

            feedback_data = {
                'is_inter_rater': True,
                'original_span_id': 'original_span_123',
                'rater_id': 'rater_user_1',
                'relevance': 4,
            }

            # Mock the HTTP request to Phoenix
            with patch('httpx.post') as mock_post:
                mock_response = Mock()
                mock_response.status_code = 200
                mock_response.json.return_value = {'data': []}
                mock_post.return_value = mock_response

                result = submit_span_annotation(
                    span_id='12345',
                    feedback_data=feedback_data,
                    qa_id='test_qa_1'
                )

                # Verify the annotation was submitted
                assert mock_post.called

                # Get the submitted data
                call_args = mock_post.call_args
                submitted_data = call_args[1]['json']['data']

                # Find the relevance annotation and check its name
                relevance_annotation = next(
                    (a for a in submitted_data if 'relevance' in a.get('id', '')),
                    None
                )

                assert relevance_annotation is not None
                assert relevance_annotation['name'] == '[inter-rating-1] Relevance Rating'

