    @pytest.mark.asyncio
    async def test_phoenix_query_error_uses_fallback(self):
        """
        Test: Phoenix query error handling with fallback to [Inter-rater]

        Scenario from spec:
        - WHEN Phoenix API query fails
        - THEN the system SHALL use fallback format [Inter-rater]
        - AND SHALL log the error
        """
        # Mock Phoenix client to raise an exception
        with patch('backend.services.phoenix_client.phoenix_client') as mock_client:
            mock_client.get_inter_rater_count = AsyncMock(side_effect=Exception("Phoenix API error"))

            feedback_data = {
                'is_inter_rater': True,
                'original_span_id': 'original_span_123',
                'rater_id': 'rater_user_1',
                'relevance': 4,
            }

            with patch('httpx.post') as mock_post:
                mock_response = Mock()
                mock_response.status_code = 200
                mock_response.json.return_value = {'data': []}
                mock_post.return_value = mock_response

                # Should not raise exception - should use fallback
                result = submit_span_annotation(
                    span_id='12345',
                    feedback_data=feedback_data,
                    qa_id='test_qa_error'
                )

                assert mock_post.called
                call_args = mock_post.call_args
                submitted_data = call_args[1]['json']['data']

                relevance_annotation = next(
                    (a for a in submitted_data if 'relevance' in a.get('id', '')),
                    None
                )

                assert relevance_annotation is not None
                # Should use fallback format
                assert relevance_annotation['name'] == '[Inter-rater] Relevance Rating'

    def test_all_annotation_types_get_numbered(self):
        """
        Test: All annotation types receive inter-rating prefix

        Validates that all 15+ annotation types are properly prefixed:
        - User Comment, Relevance Rating, Factual Accuracy, Clarity
        - Analysis Quality, Query Difficulty, Tags, Faults, etc.
        """
        with patch('backend.services.phoenix_client.phoenix_client') as mock_client:
            mock_client.get_inter_rater_count = AsyncMock(return_value=1)

            feedback_data = {
                'is_inter_rater': True,
                'original_span_id': 'original_span_123',
                'rater_id': 'rater_user_1',
                'feedback_text': 'Test comment',
                'relevance': 4,
                'factual_accuracy': 5,
                'clarity': 4,
                'analysis_quality': 5,
                'difficulty': 3,
                'tags': ['test-tag'],
            }

            with patch('httpx.post') as mock_post:
                mock_response = Mock()
                mock_response.status_code = 200
                mock_response.json.return_value = {'data': []}
                mock_post.return_value = mock_response

                result = submit_span_annotation(
                    span_id='12345',
                    feedback_data=feedback_data,
                    qa_id='test_qa_all'
                )

                assert mock_post.called
                call_args = mock_post.call_args
                submitted_data = call_args[1]['json']['data']

                # Check that all annotations have the [inter-rating-2] prefix
                for annotation in submitted_data:
                    annotation_name = annotation.get('name', '')
                    assert annotation_name.startswith('[inter-rating-2]'), \
                        f"Annotation '{annotation_name}' does not have correct prefix"


class TestInterRaterCountDetermination:
    """Test suite for inter-rater count determination logic"""

    @pytest.mark.asyncio
    async def test_zero_count_gives_number_one(self):
        """
        Test: No existing inter-rater annotations results in number 1

        Scenario from spec:
        - WHEN querying annotations for a span with no inter-rater feedback
        - THEN the inter-rater count SHALL be 0
        - AND the next inter-rater number SHALL be 1
        """
        with patch('backend.services.phoenix_client.phoenix_client') as mock_client:
            mock_client.get_inter_rater_count = AsyncMock(return_value=0)

            # Call get_inter_rater_count
            count = await mock_client.get_inter_rater_count('span_123')

            assert count == 0
            next_number = count + 1
            assert next_number == 1

    @pytest.mark.asyncio
    async def test_existing_count_increments_correctly(self):
        """
        Test: Existing inter-rater annotations are counted correctly

        Scenario from spec:
        - WHEN querying annotations for a span with existing inter-rater feedback
        - THEN the inter-rater count SHALL equal the number of unique rater_ids
        - AND the next inter-rater number SHALL be count + 1
        """
        with patch('backend.services.phoenix_client.phoenix_client') as mock_client:
            # Simulate 2 existing inter-raters
            mock_client.get_inter_rater_count = AsyncMock(return_value=2)

            count = await mock_client.get_inter_rater_count('span_123')

            assert count == 2
            next_number = count + 1
            assert next_number == 3


