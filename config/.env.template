# ATLAS Environment Configuration Template
# Copy this file to .env and fill in the values
# This file is for non-secret items. Set secret configs in .secrets.

# ===== ENVIRONMENT TOGGLE =====
# Set to 'dev', 'staging', or 'prod' to switch environments
ENVIRONMENT=dev

# For dev (Native Flask + Docker on localhost)
API_URL_DEV=https://localhost

# For staging (Native Flask + React + Redis on 'ubuntu' staging machine. Add '192.168.20.17	ubuntu.local' to /etc/hosts file on your dev machine)
API_URL_STAGING=https://ubuntu.local
# or
API_URL_STAGING=https://staging_ip_address

# For production (Native Flask + React + Redis on production server)
API_URL_PROD=https://your-production-domain.com
# or
API_URL_PROD=https://production_address

# Python version for virtual environment
PYTHON_VERSION="3.10"

# Project title
REACT_APP_SITE_TITLE="ATLAS"

# Will be automatically set by setup_env.sh based on the environment.
SERVER_NAME=localhost
HOST=${SERVER_NAME}

# SSL
DEV_CERTS_PATH=~/keys/dev_certs
CERTS_PATH=${DEV_CERTS_PATH}

# Redis configuration
REDIS_HOST="localhost"
REDIS_PORT="6379"

# Set the main retriever. It's used in app.py to connect the React UI. Alternative retrievers could be produced for different vector stores.
RETRIEVER_MODULE=modules.retriever
# Define the test target, which will be imported into the main retriever file.
TEST_TARGET=backend.targets.blert_500.blert_500

# Observability & monitoring
# Environment-specific project names (used by setup_env.sh based on environment)
PHOENIX_PROJECT_NAME_DEV=ATLAS-Dev
PHOENIX_PROJECT_NAME_STAGING=ATLAS-Staging
PHOENIX_PROJECT_NAME_PROD=ATLAS-Prod
# The active project name will be set by setup_env.sh based on the environment. 
PHOENIX_PROJECT_NAME=${PHOENIX_PROJECT_NAME_DEV}
PHOENIX_COLLECTOR_ENDPOINT="https://collector.arize.com/v1"
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES="service.name=atlas,service.version=0.1.0"

# Ollama configuration
OLLAMA_ENDPOINT="http://localhost:11434"


