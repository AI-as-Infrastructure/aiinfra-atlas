# LFS tracking for large files  
# Exclude chromadb from LFS (too large for GitHub)
backend/targets/chroma_db/** -text
targets/chroma_db/** -text
# Explicitly exclude BERT model files
models/bert_1890_1900_st/** -text
models/bert_1890_1900_st/* -text
# Track other sqlite3 files with LFS (but not chroma ones)
*.sqlite3 filter=lfs diff=lfs merge=lfs -text
backend/targets/chroma_db/*.sqlite3 -text
targets/chroma_db/*.sqlite3 -text
